# SupportAI RAG Agent v2 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Get a free Groq API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Auth (auto-generated if not set, but set this for stable sessions) ────────
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_32_char_secret_here

# ── Optional Kaggle (for downloading real datasets) ───────────────────────────
# Get at: https://www.kaggle.com/settings → API → Create New Token
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
